#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. ./config.env
version=$(sed -n 's/^sbt.version=//p' project/build.properties)
cache="${XDG_CACHE_HOME:-$HOME/.cache}/sprout-http"
launcher="$cache/sbt-launch-$version.jar"
mkdir -p "$cache"
if [ ! -f "$launcher" ]; then
  temp=$(mktemp "$cache/launcher.XXXXXX")
  trap 'rm -f "$temp" "$temp.sha1"' EXIT HUP INT TERM
  url="https://repo.maven.apache.org/maven2/org/scala-sbt/sbt-launch/$version/sbt-launch-$version.jar"
  curl --fail --location --silent --show-error --retry 3 "$url" -o "$temp"
  curl --fail --location --silent --show-error --retry 3 "$url.sha1" -o "$temp.sha1"
  printf '%s  %s\n' "$(cat "$temp.sha1")" "$temp" | sha1sum --check --status
  mv "$temp" "$launcher"
  rm -f "$temp.sha1"
  trap - EXIT HUP INT TERM
fi
export COURSIER_REPOSITORIES="https://repo.maven.apache.org/maven2"
exec groot use-jdk "$JDK_MAJOR" -- java \
  -Xmx2g -Xss4m -XX:ActiveProcessorCount=4 \
  -Dsbt.override.build.repos=true \
  -Dsbt.repository.config=project/repositories \
  -Dsbt.supershell=false -Dsbt.server.autostart=false \
  -jar "$launcher" "$@"
