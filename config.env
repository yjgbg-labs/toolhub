PROJECT_NAME=sprout-http
PROJECT_VERSION=0.1.0-SNAPSHOT
JDK_MAJOR=25
# Published release consumed directly by the deploy jobs.
ARTIFACT_SHA256="${ARTIFACT_SHA256:-b6f1730c7045580f2816d2ed8de98f4c3eb8322d868315b64aaccfe257beee91}"
ARTIFACT_NAME="${ARTIFACT_NAME:-$PROJECT_NAME-$ARTIFACT_SHA256.tar.gz}"
ARTIFACT_UPLOAD_BASE="${ARTIFACT_UPLOAD_BASE:-rustfs/public/sprout-http}"
ARTIFACT_DOWNLOAD_BASE="${ARTIFACT_DOWNLOAD_BASE:-http://s3.yjgbg.lab:9000/public/sprout-http}"

DEPLOY_DOWNLOAD_BASE="${DEPLOY_DOWNLOAD_BASE:-$ARTIFACT_DOWNLOAD_BASE}"
DEPLOY_ROOT="${DEPLOY_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/sprout-http}"
CLI_BIN_DIR="${CLI_BIN_DIR:-$HOME/.local/bin}"
SYSTEMD_UNIT_DIR="${SYSTEMD_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
OPENCODE_PLUGIN_DIR="${OPENCODE_PLUGIN_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins}"
SERVER_SERVICE="${SERVER_SERVICE:-groot-sprout-http.service}"
SERVER_SOCKET="${SERVER_SOCKET:-${XDG_RUNTIME_DIR:-$HOME/.local/run}/sprout-http/http.sock}"
SERVER_START_TIMEOUT_MS="${SERVER_START_TIMEOUT_MS:-30000}"
CLIENT_BASE_URL="${CLIENT_BASE_URL:-unix://$SERVER_SOCKET}"
PLUGIN_NAMESPACE="${PLUGIN_NAMESPACE:-sprout}"
SPROUT_HOME="${SPROUT_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sprout}"
