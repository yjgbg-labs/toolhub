# Protocol libraries: independent of business schema versions.
SDK_ORGANIZATION="${SDK_ORGANIZATION:-lab.yjgbg}"
SDK_VERSION="${SDK_VERSION:-0.2.0}"
SDK_MAVEN_REPOSITORY="${SDK_MAVEN_REPOSITORY:-$HOME/.m2/repository}"
# Only these coordinates change when generating a new business SDK.
SDK_CLIENT_VERSION="${SDK_CLIENT_VERSION:-0.2.0-SNAPSHOT}"
SDK_CLIENT_MODULE="${SDK_CLIENT_MODULE:-sprout-client}"
SDK_CLIENT_PACKAGE="${SDK_CLIENT_PACKAGE:-sprout.generated}"
SDK_CLIENT_SOURCES="${SDK_CLIENT_SOURCES:-scala-sdk/generated/sprout}"
# Native CLI is a protocol release, deployed independently of server/business SDKs.
SDK_CLI_SHA256="${SDK_CLI_SHA256:-d9db584f02b549732a847216a68dad57829a3e8cac2674572b794b3c8b1a9844}"
SDK_CLI_UPLOAD_BASE="${SDK_CLI_UPLOAD_BASE:-rustfs/public/sprout-http/native-cli}"
SDK_CLI_DOWNLOAD_BASE="${SDK_CLI_DOWNLOAD_BASE:-http://s3.yjgbg.lab:9000/public/sprout-http/native-cli}"
SDK_CLI_INSTALL_ROOT="${SDK_CLI_INSTALL_ROOT:-$HOME/.local/share/sprout-native}"
SDK_CLI_BIN_DIR="${SDK_CLI_BIN_DIR:-${CLI_BIN_DIR:-$HOME/.local/bin}}"
